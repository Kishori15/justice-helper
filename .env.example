# Google Gemini API Keys
GEMINI_API_KEY=
GEMINI_API_KEYS=                 # Optional comma-separated list of keys for rotation

# Fallback LLM Provider (Groq / Together AI)
FALLBACK_LLM_PROVIDER=groq        # groq | together
FALLBACK_LLM_API_KEY=

# Model Selection
GEMINI_MODEL=gemini-2.0-flash
FALLBACK_MODEL=llama-3.3-70b-versatile

# Storage Path
DB_PATH=data/justicehelper.db

# Embedding and Reranking Models (sentence-transformers)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# Server & Client URLs
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_BASE_URL=http://127.0.0.1:8000
